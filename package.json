{
  "name": "caminos-rurales-carlos-tejedor",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de relevamiento, consolidación y gestión de reclamos de caminos rurales de Carlos Tejedor",
  "scripts": {
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "db:test": "node --env-file=.env scripts/db-test.mjs",
    "db:check": "node --env-file=.env scripts/check-keys.mjs",
    "dev:admin": "npm --prefix apps/admin run dev",
    "build:admin": "npm --prefix apps/admin run build",
    "dev:mobile": "npm --prefix apps/mobile run start"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "typescript": "^5.4.0"
  }
}
